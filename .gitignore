# 运行产物与任务数据（代码与数据彻底隔离）
runs/
成品/
index-tts/
models/
.cache/
.venv/
.workbuddy/
.zcode/
.zcodeignore

# 内部研发文档与归档脚本（非公开开源资产）
docs_archive/
pipeline/_legacy/

# 音视频与大体积二进制媒体（严禁入库）
*.mp4
*.m4a
*.wav
*.aac
*.mp3
*.flac
*.mov
assets/voice_library/*.wav

# 本地数据库与临时进程/日志
*.db
*.sqlite
*.sqlite3
*.log
*.pid

# 图片抽帧与临时素材（保留必要的资产图示）
sheet_*.jpg
*.jpg
*.jpeg
*.png
!assets/images/**/*.png
!assets/images/**/*.jpg
!assets/images/**/*.svg

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# 系统临时文件
.DS_Store
Thumbs.db
